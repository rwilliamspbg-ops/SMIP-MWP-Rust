          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single"
        }
      },
      "targets": [
        {
          "datasource": "$datasource",
          "expr": "histogram_quantile(0.99, rate(mohawk_packet_latency_bucket[1s]))",
          "legendFormat": "{{interface}} p99",
          "refId": "A"
        }
      ],
      "title": "Latency p99 (µs)",
