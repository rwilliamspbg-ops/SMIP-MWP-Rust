        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": "$datasource",
          "expr": "mohawk_afxdp_retry_count_total * 100 / mohawk_packets_processed_total",
          "legendFormat": "{{interface}} retry rate",
          "refId": "A"
        }
