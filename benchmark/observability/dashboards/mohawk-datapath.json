  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "datasource": "$datasource",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "axisLabelShow": true,
            "axisStyle": "solid",
            "decimals": 2,
            "fillOpacity": 10,
            "lineWidth": 1,
            "showThresholdLabels": false,
            "showThresholdMarkers": true
          },
          "unit": "bytes"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "legend": {
          "calcs": [
            "mean",
            "max"
          ],
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single"
        }
      },
      "targets": [
        {
          "datasource": "$datasource",
          "expr": "rate(mohawk_packets_processed_total[1s]) * 8 / 1024 / 1024",
          "legendFormat": "{{interface}} throughput",
          "refId": "A"
        }
      ],
      "title": "Throughput (GiB/s)",
      "type": "timeseries"
    },
    {
      "datasource": "$datasource",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "axisLabelShow": true,
            "axisStyle": "solid",
            "decimals": 2,
